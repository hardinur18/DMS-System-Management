VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
VITE_USE_APP_USERS_FUNCTION=false

# Server-side scripts only. Do not expose these in Vite/browser code.
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_ACCESS_TOKEN=your-supabase-personal-access-token
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@your-pooler-host:6543/postgres

BIOFINGER_HOST=192.168.1.201
BIOFINGER_PORT=4370
BIOFINGER_COMM_KEY=0
BIOFINGER_TIMEZONE_OFFSET=+07:00
BIOFINGER_DEVICE_CODE=BIO-AT301-001
BIOFINGER_EXPORT_DIR=exports
BIOFINGER_LOG_DIR=logs/biofinger-sync
BIOFINGER_PYTHON=
BIOFINGER_NODE=

# VPS/cloud push receiver for AT-301 ADMS mode. Server-side only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
BIOFINGER_ADMS_HOST=0.0.0.0
BIOFINGER_ADMS_PORT=8090
BIOFINGER_DEVICE_NAME=Biofinger-AT301-Main-Gate
BIOFINGER_DEVICE_MODEL=AT-301
BIOFINGER_DEVICE_CODE_PREFIX=BIO-AT301
BIOFINGER_ALLOWED_SERIALS=GED7244800117
BIOFINGER_ALLOWED_REMOTE_IPS=
BIOFINGER_RECEIVER_TOKEN=
BIOFINGER_RECEIVER_DRY_RUN=false
BIOFINGER_RECEIVER_LOG_PAYLOAD=false
